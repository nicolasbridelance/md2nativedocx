{
  "name": "@md2nativedocx/pptx",
  "version": "0.1.0",
  "description": "Rewrites the DrawingML shapes produced by @md2nativedocx/core into a .pptx deck (one slide per Mermaid block) \u2014 no new per-diagram translators.",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicolasbridelance/md2nativedocx",
    "directory": "packages/pptx"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test dist-test/test/*.test.js",
    "pretest:ci": "tsc -p tsconfig.test.json && mkdir -p reports",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit.xml dist-test/test/*.test.js"
  },
  "dependencies": {
    "@md2nativedocx/core": "0.1.0",
    "@md2nativedocx/pandoc-filter": "0.1.0",
    "adm-zip": "^0.6.1",
    "fast-xml-parser": "^5.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.4"
  }
}

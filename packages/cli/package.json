{
  "name": "@md2nativedocx/cli",
  "version": "0.1.0",
  "description": "Complete Markdown to Word (.docx) converter, or PowerPoint (.pptx), with editable diagrams — all 29 Mermaid types become real shapes, SmartArt and charts that readers can change in Word, not flattened PNGs.",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicolasbridelance/md2nativedocx",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/nicolasbridelance/md2nativedocx#readme",
  "bugs": {
    "url": "https://github.com/nicolasbridelance/md2nativedocx/issues"
  },
  "keywords": [
    "mermaid",
    "mermaid-to-docx",
    "markdown-to-docx",
    "markdown-to-word",
    "docx",
    "pptx",
    "word",
    "powerpoint",
    "diagram",
    "editable",
    "pandoc",
    "ooxml",
    "drawingml",
    "markdown"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "md2nativedocx": "bin/md2nativedocx.mjs"
  },
  "files": [
    "bin",
    "src",
    "assets"
  ],
  "scripts": {
    "build": "echo \"cli: no build step (plain JS)\"",
    "typecheck": "echo \"cli: no typecheck step\"",
    "test": "node --test test/*.test.mjs",
    "pretest:ci": "mkdir -p reports",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit.xml test/*.test.mjs"
  },
  "dependencies": {
    "@md2nativedocx/pandoc-filter": "0.1.0",
    "@md2nativedocx/pptx": "0.1.0",
    "adm-zip": "^0.6.1"
  }
}

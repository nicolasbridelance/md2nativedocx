{
  "name": "md2nativedocx",
  "displayName": "md2nativedocx — Markdown to Word with editable diagrams (+ PowerPoint)",
  "description": "%extension.description%",
  "version": "0.8.0",
  "publisher": "md2nativedocx",
  "private": true,
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicolasbridelance/md2nativedocx",
    "directory": "packages/vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/nicolasbridelance/md2nativedocx/issues"
  },
  "homepage": "https://github.com/nicolasbridelance/md2nativedocx#readme",
  "type": "commonjs",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "icon": "icon.png",
  "l10n": "./l10n",
  "galleryBanner": {
    "color": "#2B2140",
    "theme": "dark"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "mermaid",
    "mermaid to word",
    "mermaid to docx",
    "markdown to word",
    "markdown to docx",
    "word",
    "docx",
    "microsoft word",
    "powerpoint",
    "pptx",
    "diagram",
    "diagrams",
    "flowchart",
    "sequence diagram",
    "export",
    "convert",
    "ooxml",
    "drawingml",
    "smartart",
    "pandoc",
    "editable",
    "native shapes",
    "vector",
    "quarto"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:mermaid",
    "onLanguage:quarto"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mermaid",
        "aliases": [
          "Mermaid",
          "mermaid"
        ],
        "extensions": [
          ".mmd"
        ]
      }
    ],
    "commands": [
      {
        "command": "md2nativedocx.exportDocument",
        "title": "%command.exportDocument.title%",
        "shortTitle": "%command.exportDocument.shortTitle%",
        "category": "md2nativedocx"
      },
      {
        "command": "md2nativedocx.exportDocumentPptx",
        "title": "%command.exportDocumentPptx.title%",
        "shortTitle": "%command.exportDocumentPptx.shortTitle%",
        "category": "md2nativedocx"
      },
      {
        "command": "md2nativedocx.exportDocumentOdt",
        "title": "%command.exportDocumentOdt.title%",
        "shortTitle": "%command.exportDocumentOdt.shortTitle%",
        "category": "md2nativedocx"
      },
      {
        "command": "md2nativedocx.exportBlock",
        "title": "%command.exportBlock.title%",
        "shortTitle": "%command.exportBlock.shortTitle%",
        "category": "md2nativedocx"
      },
      {
        "command": "md2nativedocx.exportBlockDocx",
        "title": "%command.exportBlockDocx.title%",
        "category": "md2nativedocx"
      },
      {
        "command": "md2nativedocx.exportBlockPptx",
        "title": "%command.exportBlockPptx.title%",
        "category": "md2nativedocx"
      },
      {
        "command": "md2nativedocx.exportBlockOdt",
        "title": "%command.exportBlockOdt.title%",
        "category": "md2nativedocx"
      },
      {
        "command": "md2nativedocx.enableSetting",
        "title": "%command.enableSetting.title%",
        "category": "md2nativedocx"
      },
      {
        "command": "md2nativedocx.openSettings",
        "title": "%command.openSettings.title%",
        "category": "md2nativedocx"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "md2nativedocx",
          "title": "md2nativedocx",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "md2nativedocx": [
        {
          "id": "md2nativedocx.configView",
          "type": "webview",
          "name": "%view.configView.name%"
        }
      ]
    },
    "menus": {
      "md2nativedocx.submenu": [
        {
          "command": "md2nativedocx.exportDocument",
          "group": "1_document@1"
        },
        {
          "command": "md2nativedocx.exportDocumentPptx",
          "group": "1_document@2"
        },
        {
          "command": "md2nativedocx.exportDocumentOdt",
          "group": "1_document@3"
        },
        {
          "command": "md2nativedocx.exportBlockDocx",
          "when": "md2nativedocx.cursorInMermaidBlock && editorFocus",
          "group": "2_diagram@1"
        },
        {
          "command": "md2nativedocx.exportBlockPptx",
          "when": "md2nativedocx.cursorInMermaidBlock && editorFocus",
          "group": "2_diagram@2"
        },
        {
          "command": "md2nativedocx.exportBlockOdt",
          "when": "md2nativedocx.cursorInMermaidBlock && editorFocus",
          "group": "2_diagram@3"
        },
        {
          "command": "md2nativedocx.openSettings",
          "group": "3_settings@1"
        }
      ],
      "explorer/context": [
        {
          "submenu": "md2nativedocx.submenu",
          "when": "resourceExtname == .md || resourceExtname == .mmd || resourceExtname == .qmd",
          "group": "7_modification"
        }
      ],
      "editor/context": [
        {
          "submenu": "md2nativedocx.submenu",
          "when": "resourceExtname == .md || resourceExtname == .mmd || resourceExtname == .qmd",
          "group": "1_modification"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "md2nativedocx.submenu",
          "when": "resourceExtname == .md || resourceExtname == .mmd || resourceExtname == .qmd",
          "group": "1_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "md2nativedocx.enableSetting",
          "when": "false"
        },
        {
          "command": "md2nativedocx.exportBlockDocx",
          "when": "false"
        },
        {
          "command": "md2nativedocx.exportBlockPptx",
          "when": "false"
        },
        {
          "command": "md2nativedocx.exportBlockOdt",
          "when": "false"
        }
      ]
    },
    "configuration": [
      {
        "id": "md2nativedocx.output",
        "title": "%configuration.section.output%",
        "order": 0,
        "properties": {
          "md2nativedocx.outputDirectory": {
            "type": "string",
            "default": "",
            "markdownDescription": "%configuration.outputDirectory.markdownDescription%",
            "order": 0
          },
          "md2nativedocx.referenceDocument": {
            "type": "string",
            "default": "",
            "markdownDescription": "%configuration.referenceDocument.markdownDescription%",
            "order": 1
          }
        }
      },
      {
        "id": "md2nativedocx.diagrams",
        "title": "%configuration.section.diagrams%",
        "order": 1,
        "properties": {
          "md2nativedocx.smartArt.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%configuration.smartArt.enabled.markdownDescription%",
            "order": 0
          },
          "md2nativedocx.smartArt.style": {
            "type": "string",
            "enum": [
              "simple",
              "subtle",
              "moderate",
              "intense-accent",
              "colorful",
              "colorful-moderate",
              "intense"
            ],
            "default": "colorful",
            "enumDescriptions": [
              "%configuration.smartArt.style.simple%",
              "%configuration.smartArt.style.subtle%",
              "%configuration.smartArt.style.moderate%",
              "%configuration.smartArt.style.intense-accent%",
              "%configuration.smartArt.style.colorful%",
              "%configuration.smartArt.style.colorful-moderate%",
              "%configuration.smartArt.style.intense%"
            ],
            "markdownDescription": "%configuration.smartArt.style.markdownDescription%",
            "order": 1
          },
          "md2nativedocx.nativeCharts.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%configuration.nativeCharts.enabled.markdownDescription%",
            "order": 3
          },
          "md2nativedocx.pptx.showSource": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%configuration.pptx.showSource.markdownDescription%",
            "order": 4
          }
        }
      },
      {
        "id": "md2nativedocx.layout",
        "title": "%configuration.section.layout%",
        "order": 2,
        "properties": {
          "md2nativedocx.layout.pageSize": {
            "type": "string",
            "enum": [
              "A3",
              "A4",
              "Letter",
              "Legal"
            ],
            "default": "A4",
            "markdownDescription": "%configuration.layout.pageSize.markdownDescription%",
            "order": 0
          },
          "md2nativedocx.layout.orientation": {
            "type": "string",
            "enum": [
              "portrait",
              "landscape"
            ],
            "default": "portrait",
            "markdownDescription": "%configuration.layout.orientation.markdownDescription%",
            "order": 1
          },
          "md2nativedocx.layout.margins": {
            "type": "string",
            "enum": [
              "normal",
              "narrow",
              "moderate",
              "wide",
              "custom"
            ],
            "enumDescriptions": [
              "%configuration.layout.margins.normal%",
              "%configuration.layout.margins.narrow%",
              "%configuration.layout.margins.moderate%",
              "%configuration.layout.margins.wide%",
              "%configuration.layout.margins.custom%"
            ],
            "default": "normal",
            "markdownDescription": "%configuration.layout.margins.markdownDescription%",
            "order": 2
          },
          "md2nativedocx.layout.marginsCustomTop": {
            "type": "number",
            "default": 2.5,
            "minimum": 0.1,
            "maximum": 15,
            "markdownDescription": "%configuration.layout.marginsCustomTop.markdownDescription%",
            "order": 3
          },
          "md2nativedocx.layout.marginsCustomRight": {
            "type": "number",
            "default": 2.5,
            "minimum": 0.1,
            "maximum": 15,
            "markdownDescription": "%configuration.layout.marginsCustomRight.markdownDescription%",
            "order": 4
          },
          "md2nativedocx.layout.marginsCustomBottom": {
            "type": "number",
            "default": 2.5,
            "minimum": 0.1,
            "maximum": 15,
            "markdownDescription": "%configuration.layout.marginsCustomBottom.markdownDescription%",
            "order": 5
          },
          "md2nativedocx.layout.marginsCustomLeft": {
            "type": "number",
            "default": 2.5,
            "minimum": 0.1,
            "maximum": 15,
            "markdownDescription": "%configuration.layout.marginsCustomLeft.markdownDescription%",
            "order": 6
          },
          "md2nativedocx.layout.footerPageNumber": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%configuration.layout.footerPageNumber.markdownDescription%",
            "order": 7
          },
          "md2nativedocx.layout.landscapeTables": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%configuration.layout.landscapeTables.markdownDescription%",
            "order": 8
          }
        }
      },
      {
        "id": "md2nativedocx.typography",
        "title": "%configuration.section.typography%",
        "order": 3,
        "properties": {
          "md2nativedocx.typography.headingFont": {
            "type": "string",
            "default": "",
            "markdownDescription": "%configuration.typography.headingFont.markdownDescription%",
            "order": 0
          },
          "md2nativedocx.typography.bodyFont": {
            "type": "string",
            "default": "",
            "markdownDescription": "%configuration.typography.bodyFont.markdownDescription%",
            "order": 1
          },
          "md2nativedocx.typography.fontSize": {
            "type": "number",
            "default": 11,
            "minimum": 9,
            "maximum": 14,
            "markdownDescription": "%configuration.typography.fontSize.markdownDescription%",
            "order": 2
          },
          "md2nativedocx.typography.lineSpacing": {
            "type": "string",
            "enum": [
              "default",
              "single",
              "1.15",
              "1.5",
              "double"
            ],
            "enumDescriptions": [
              "%configuration.typography.lineSpacing.default%",
              "%configuration.typography.lineSpacing.single%",
              "%configuration.typography.lineSpacing.1.15%",
              "%configuration.typography.lineSpacing.1.5%",
              "%configuration.typography.lineSpacing.double%"
            ],
            "default": "default",
            "markdownDescription": "%configuration.typography.lineSpacing.markdownDescription%",
            "order": 3
          },
          "md2nativedocx.typography.justify": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "center",
              "both"
            ],
            "default": "left",
            "markdownDescription": "%configuration.typography.justify.markdownDescription%",
            "order": 4
          },
          "md2nativedocx.typography.accentColor": {
            "type": "string",
            "default": "",
            "pattern": "^$|^[0-9A-Fa-f]{6}$",
            "markdownDescription": "%configuration.typography.accentColor.markdownDescription%",
            "order": 5
          },
          "md2nativedocx.typography.tableHeaderColor": {
            "type": "string",
            "default": "",
            "pattern": "^$|^[0-9A-Fa-f]{6}$",
            "markdownDescription": "%configuration.typography.tableHeaderColor.markdownDescription%",
            "order": 6
          }
        }
      },
      {
        "id": "md2nativedocx.structure",
        "title": "%configuration.section.structure%",
        "order": 4,
        "properties": {
          "md2nativedocx.toc.enabled": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%configuration.toc.enabled.markdownDescription%",
            "order": 0
          },
          "md2nativedocx.toc.depth": {
            "type": "number",
            "default": 3,
            "minimum": 2,
            "maximum": 4,
            "markdownDescription": "%configuration.toc.depth.markdownDescription%",
            "order": 1
          },
          "md2nativedocx.emoji.forceColorFont": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%configuration.emoji.forceColorFont.markdownDescription%",
            "order": 2
          }
        }
      },
      {
        "id": "md2nativedocx.advanced",
        "title": "%configuration.section.advanced%",
        "order": 5,
        "properties": {
          "md2nativedocx.wordCompatibilityCheck.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%configuration.wordCompatibilityCheck.enabled.markdownDescription%",
            "order": 0
          },
          "md2nativedocx.pandoc.downloadUrl": {
            "type": "string",
            "default": "",
            "markdownDescription": "%configuration.pandoc.downloadUrl.markdownDescription%",
            "order": 1
          },
          "md2nativedocx.pandoc.sha256": {
            "type": "string",
            "default": "",
            "pattern": "^$|^[0-9a-f]{64}$",
            "markdownDescription": "%configuration.pandoc.sha256.markdownDescription%",
            "order": 2
          },
          "md2nativedocx.dotnet.downloadUrl": {
            "type": "string",
            "default": "",
            "markdownDescription": "%configuration.dotnet.downloadUrl.markdownDescription%",
            "order": 3
          },
          "md2nativedocx.dotnet.sha512": {
            "type": "string",
            "default": "",
            "pattern": "^$|^[0-9a-f]{128}$",
            "markdownDescription": "%configuration.dotnet.sha512.markdownDescription%",
            "order": 4
          }
        }
      }
    ],
    "walkthroughs": [
      {
        "id": "md2nativedocx.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "openMarkdown",
            "title": "%walkthrough.step1.title%",
            "description": "%walkthrough.step1.description%",
            "media": {
              "markdown": "walkthrough/01-open-markdown.md"
            }
          },
          {
            "id": "seeWhatItBecomes",
            "title": "%walkthrough.step2.title%",
            "description": "%walkthrough.step2.description%",
            "media": {
              "image": "docs/demo-hover.gif",
              "altText": "%walkthrough.step2.altText%"
            }
          },
          {
            "id": "export",
            "title": "%walkthrough.step3.title%",
            "description": "%walkthrough.step3.description%",
            "media": {
              "image": "docs/demo-vscode.gif",
              "altText": "%walkthrough.step3.altText%"
            }
          },
          {
            "id": "editInWord",
            "title": "%walkthrough.step4.title%",
            "description": "%walkthrough.step4.description%",
            "media": {
              "markdown": "walkthrough/04-edit-in-word.md"
            }
          }
        ]
      }
    ],
    "submenus": [
      {
        "id": "md2nativedocx.submenu",
        "label": "md2nativedocx"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle-analysis.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --experimental-test-module-mocks --test dist-test/test/unit/*.test.js",
    "pretest:ci": "tsc -p tsconfig.test.json && mkdir -p reports",
    "test:ci": "node --experimental-test-module-mocks --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit.xml dist-test/test/unit/*.test.js",
    "pretest:extension-host": "tsc -p tsconfig.test.json",
    "test:extension-host": "node scripts/run-extension-host-tests.mjs",
    "bundle": "node scripts/bundle-cli.mjs && node scripts/bundle-oxml-validator.mjs",
    "prepackage": "npm run build && npm run bundle",
    "package": "vsce package --no-dependencies -o md2nativedocx.vsix --baseContentUrl https://github.com/nicolasbridelance/md2nativedocx/blob/main/packages/vscode-extension/ --baseImagesUrl https://github.com/nicolasbridelance/md2nativedocx/raw/main/packages/vscode-extension/",
    "publish": "npm run build && npm run bundle && vsce publish --no-dependencies --baseContentUrl https://github.com/nicolasbridelance/md2nativedocx/blob/main/packages/vscode-extension/ --baseImagesUrl https://github.com/nicolasbridelance/md2nativedocx/raw/main/packages/vscode-extension/"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@md2nativedocx/cli": "0.2.0"
  }
}

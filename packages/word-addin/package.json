{
  "name": "@md2nativedocx/word-addin",
  "version": "0.0.1",
  "private": true,
  "license": "CC0-1.0",
  "config": {
    "app_to_debug": "word",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "office-addin-lint check",
    "lint:fix": "office-addin-lint fix",
    "prettier": "office-addin-lint prettier",
    "watch": "webpack --mode development --watch",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --require ./test/setup.cjs --test dist-test/test/**/*.test.js",
    "pretest:ci": "tsc -p tsconfig.test.json && mkdir -p reports",
    "test:ci": "node --require ./test/setup.cjs --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit.xml dist-test/test/**/*.test.js"
  },
  "dependencies": {
    "core-js": "^3.36.0",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-typescript": "^8.0.1",
    "@types/node": "^26.6.3",
    "@types/office-js": "^1.0.610",
    "@types/office-runtime": "^1.0.35",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "eslint-plugin-office-addins": "^5.0.1",
    "file-loader": "^6.2.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "office-addin-cli": "^3.0.1",
    "office-addin-lint": "^4.0.1",
    "office-addin-mock": "^4.0.1",
    "office-addin-prettier-config": "^3.0.1",
    "os-browserify": "^0.3.0",
    "process": "^0.11.10",
    "source-map-loader": "^5.0.0",
    "typescript": "^7.0.2",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "prettier": "office-addin-prettier-config",
  "browserslist": [
    "last 2 versions"
  ]
}

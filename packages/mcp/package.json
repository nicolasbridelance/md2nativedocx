{
  "name": "@md2nativedocx/mcp",
  "version": "0.1.0",
  "description": "MCP server for md2nativedocx: render_diagram and convert_document tools, each run in a child process killed at a deadline.",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicolasbridelance/md2nativedocx",
    "directory": "packages/mcp"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "md2nativedocx-mcp": "bin/md2nativedocx-mcp.mjs"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "build": "echo \"mcp: no build step (plain JS)\"",
    "typecheck": "echo \"mcp: no typecheck step\"",
    "test": "node --test test/*.test.mjs",
    "pretest:ci": "mkdir -p reports",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit.xml test/*.test.mjs"
  },
  "dependencies": {
    "@md2nativedocx/cli": "0.1.0",
    "@md2nativedocx/core": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  }
}

{
  "name": "md2nativedocx",
  "version": "0.1.0",
  "description": "Markdown to Word (.docx) — a complete document conversion that also turns embedded Mermaid diagrams into native, editable OOXML vector shapes, not flattened PNGs.",
  "license": "CC0-1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "test": "npm run test --workspaces",
    "test:ci": "npm run test:ci --workspaces",
    "test:fuzz": "npm run test:fuzz -w packages/core",
    "test:visual": "node scripts/test-visual.mjs",
    "test:visual:update-baseline": "node scripts/test-visual.mjs --update-baseline",
    "test:oxml-validate": "node scripts/test-oxml-validate.mjs",
    "verify:npm-packages": "node scripts/verify-npm-packages.mjs",
    "audit:gate": "node scripts/audit-gate.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-security": "^3.0.1",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "serialize-javascript": "^7.1.2",
    "diff": "^8.0.3",
    "adm-zip": "^0.6.1",
    "qs": "^6.16.0"
  }
}
